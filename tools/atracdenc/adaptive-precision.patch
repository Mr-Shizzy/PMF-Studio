     TSpecFrame frame(FrameSzToAllocBits, initialNumQuantUnits, channels, tonalBlock, sces);
 
+    // How many quant units (bandwidth) a frame of this size should keep before the precision is lowered: all of them for big frames, fewer for small ones.
+    // (Quant unit n ends at coefficient 0,16,32,..: 8 -> 1.4 kHz, 16 -> 4.1 kHz, 20 -> 6.9 kHz, 22 -> 8.3 kHz, 24 -> 11 kHz, 26 -> 15 kHz, 28 -> 18 kHz.)
+    static const struct { uint32_t bytes; uint32_t qu; } kMinQu[] = {
+        {0, 12}, {192, 16}, {280, 20}, {376, 22}, {560, 24}, {744, 26}, {1024, 32}
+    };
+    uint32_t minQu = 32;
+    for (size_t i = 1; i < sizeof(kMinQu) / sizeof(kMinQu[0]); i++) {
+        if (FrameSz <= kMinQu[i].bytes) {
+            const auto& a = kMinQu[i - 1];
+            const auto& b = kMinQu[i];
+            minQu = a.qu + (b.qu - a.qu) * (FrameSz - a.bytes) / (b.bytes - a.bytes);
+            break;
+        }
+    }
+    if (const char* e = getenv("AT3P_MINQU")) {
+        minQu = static_cast<uint32_t>(atoi(e));
+    }
+    frame.MinQuantUnits = minQu > 32 ? 32 : (minQu < 1 ? 1 : minQu);
+
