-static void CheckSndFileOpen(SndfileHandle& file, const std::string& path, const char* mode) {
-    if (file.rawHandle()) {
-        return;
-    }
-
-    std::string msg = "unable to open ";
-    msg += mode;
-    msg += " file '";
-    msg += path;
-    msg += "'";
-
-    if (file) {
-        const char* err = file.strError();
-        if (err && err[0]) {
-            msg += ": ";
-            msg += err;
-        }
-    }
-
-    throw std::runtime_error(msg);
-}
